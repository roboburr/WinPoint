<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Win11 Shell: the admin part of Taakbeheer › Opslag › "Ruimte vrijmaken".
     Install: sudo install -Dm644 nl.win11shell.cleanup.policy /usr/share/polkit-1/actions/
              sudo install -Dm755 win11shell-cleanup-helper /usr/libexec/win11shell/cleanup-helper -->
<policyconfig>
  <vendor>Win11 Shell</vendor>
  <action id="nl.win11shell.cleanup">
    <description>Clean up update files and old logs</description>
    <description xml:lang="nl">Oude updatebestanden en logboeken opruimen</description>
    <message>Win11 Shell wants to remove downloaded update packages, old snap versions and old logs to free up disk space.</message>
    <message xml:lang="nl">Win11 Shell wil gedownloade updatebestanden, oude snap-versies en oude logboeken verwijderen om ruimte vrij te maken.</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/win11shell/cleanup-helper</annotate>
  </action>
</policyconfig>
