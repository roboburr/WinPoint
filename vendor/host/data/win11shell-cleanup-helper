#!/bin/sh
# Win11 Shell — "Ruimte vrijmaken" admin steps, run through pkexec (one password prompt).
# Installed root-owned as /usr/libexec/win11shell/cleanup-helper together with
# /usr/share/polkit-1/actions/nl.win11shell.cleanup.policy, so the password dialog says in plain Dutch
# what will happen instead of "run /bin/sh as the super user". Only these fixed steps exist:
#   apt                  apt-get clean (downloaded update packages)
#   journal              journalctl --vacuum-time=14d (logbooks older than 14 days)
#   snap:<name>=<rev>    snap remove <name> --revision=<rev> (an old, disabled snap revision)
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
for step in "$@"; do
  case "$step" in
    apt) if apt-get clean; then echo "@@ok apt"; else echo "@@fail apt"; fi ;;
    journal) if journalctl --vacuum-time=14d >/dev/null 2>&1; then echo "@@ok journal"; else echo "@@fail journal"; fi ;;
    snap:*)
      s="${step#snap:}"; n="${s%%=*}"; r="${s#*=}"
      case "$n$r" in *[!a-z0-9x-]*) echo "@@fail snap"; continue ;; esac
      if snap remove "$n" --revision="$r" >/dev/null 2>&1; then echo "@@ok snap"; else echo "@@fail snap"; fi ;;
    *) echo "@@fail unknown" ;;
  esac
done
