#!/bin/sh
# Win11 voor GNOME: the "Nieuwe Ubuntu-versies" setting (notes/claude/windows-update-gnome.md sections 6.3 and 7).
# Installed root-owned 0755 as /usr/libexec/win11-gnome/release-upgrades-helper together with the polkit action
# io.github.win11shell.gnome.release-upgrades (scripts/install-system.py), and run only through pkexec, so the
# password dialog says what happens instead of "run /bin/sh as the super user". Without it, Settings runs this same
# text through `pkexec /bin/sh -c '<this file>' win11-gnome-prompt set-prompt <value>` (host admin.rs).
#
# One job, exact arguments:
#   set-prompt lts|normal|never   set Prompt= in [DEFAULT] of /etc/update-manager/release-upgrades
# It changes only that line (or adds it), keeps every comment and other line, and writes the file as a temp file
# release-upgrades.win11-gnome.tmp in the same directory. Before the temp file replaces the file, it is read back the
# way Ubuntu reads it; only when Ubuntu would read exactly Prompt=<value> from it does it become root:root, mode 0644,
# synced, and moved into place.
# Output: ASCII machine markers only, one per line:
#   @@ok prompt=<value>       the file now says Prompt=<value>
#   @@override <file>         a release-upgrades.d/*.cfg that sets Prompt too (the last one decides for Ubuntu)
#   @@fail <code>             nothing was changed (usage, notroot, etc, nodir, symlink, notfile, tmp, write, parse,
#                             chown, chmod, sync, mv); parse: Ubuntu would not read Prompt=<value> from the result
#                             (the file has a line it refuses, or a character this reader cannot judge)
# Tests (tests/update/test_helpers.sh) run it as the user with WIN11_HELPER_ETC=<a temp etc>; that variable counts
# only when the helper does not run as root (pkexec clears the environment anyway), and the file then belongs to the
# user.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022
LC_ALL=C
export LC_ALL

fail() {
  echo "@@fail $1"
  exit "${2:-1}"
}

[ "$#" -eq 2 ] || fail usage 2
[ "$1" = set-prompt ] || fail usage 2
case "$2" in
  lts|normal|never) value=$2 ;;
  *) fail usage 2 ;;
esac

etc=/etc
owner=0:0
if [ "$(id -u)" != 0 ]; then
  [ -n "${WIN11_HELPER_ETC:-}" ] || fail notroot 3
  case "$WIN11_HELPER_ETC" in
    /*) ;;
    *) fail etc 3 ;;
  esac
  etc=$WIN11_HELPER_ETC
  owner="$(id -u):$(id -g)"
fi

dir=$etc/update-manager
file=$dir/release-upgrades
tmp=$dir/release-upgrades.win11-gnome.tmp
{ [ -d "$dir" ] && [ ! -L "$dir" ]; } || fail nodir
[ ! -L "$file" ] || fail symlink
[ ! -e "$file" ] || [ -f "$file" ] || fail notfile
[ ! -e "$tmp" ] && [ ! -L "$tmp" ] || rm -f -- "$tmp" || fail tmp

# Ubuntu reads each file with Python's configparser (MetaRelease._parse_cfg: ConfigParser with its defaults, one
# parser per file; any configparser error ignores the whole file). This awk program follows that reader line by line:
# a comment is a line starting with # or ; after its spaces, a blank line or a comment never ends a value, a line
# indented deeper than the line of the current key continues its value, a section header is "[" + name + the last "]"
# of the line, a key ends at the first = or :, keys are case-insensitive; a key before any section, a line that is
# neither, an empty key, a key twice in a section and a section other than DEFAULT twice make Ubuntu ignore the file.
# A lone CR (Python ends a line there) or a Unicode space (Python strips it) outside a comment line is a character this
# reader cannot judge: such a file never passes "check". Modes:
#   rewrite  the file with Prompt=<v>: the first Prompt key of [DEFAULT] becomes Prompt=<v> (its indentation and line
#            end kept), its continuation lines and any second Prompt key there go; without such a key, Prompt=<v>
#            follows the last line of the first [DEFAULT] section (blank lines before the next section stay after it,
#            the indentation of that section header keeps it a header), or a new [DEFAULT] ends a file without one
#   check    exit 0 only when Ubuntu reads exactly Prompt=<v> from the file
#   probe    exit 0 when Ubuntu reads a Prompt key from the file
CFG='
function strip(s) { sub(/^[ \t\v\f]+/, "", s); sub(/[ \t\v\f]+$/, "", s); return s }
function lead(s) { match(s, /[^ \t\v\f]/); return RSTART ? substr(s, 1, RSTART - 1) : s }
function last(s, c,   i, p) { p = 0; for (i = 1; i <= length(s); i++) if (substr(s, i, 1) == c) p = i; return p }
function flush() { printf "%s", held; held = "" }
function put(ind) { print ind "Prompt=" v eol; done = 1 }
BEGIN { EXOTIC = "[\034-\037]|\302[\205\240]|\341\232\200|\342\200[\200-\212\250\251\257]|\342\201\237|\343\200\200" }
{
  raw = $0; cr = ""
  if (raw ~ /\r$/) { raw = substr(raw, 1, length(raw) - 1); cr = "\r" }
  if (NR == 1) eol = cr
  t = strip(raw)
  if (raw ~ /\r/ || (raw ~ EXOTIC && t !~ /^[#;]/)) odd = 1
  if (t == "" || t ~ /^[#;]/) {
    kind = (t == "") ? "blank" : "comment"
    if (kind == "blank" && sect == "DEFAULT" && opt == "prompt") value = value "\n"
  } else if (sect != "" && opt != "" && length(lead(raw)) > level) {
    kind = "cont"
    if (sect == "DEFAULT" && opt == "prompt") value = value "\n" t
  } else {
    level = length(lead(raw))
    p = last(t, "]")
    if (substr(t, 1, 1) == "[" && p >= 3) {
      kind = "header"
      sect = substr(t, 2, p - 2)
      opt = ""
      if (sect != "DEFAULT") { if (sect in sects) bad = 1; sects[sect] = 1 }
    } else if (sect == "") {
      kind = "error"; bad = 1
    } else if (match(t, /[=:]/)) {
      kind = "option"
      key = substr(t, 1, RSTART - 1); sub(/[ \t\v\f]+$/, "", key); key = tolower(key)
      if (key == "" || ((sect SUBSEP key) in opts)) bad = 1
      opts[sect SUBSEP key] = 1
      opt = key
      if (sect == "DEFAULT" && key == "prompt") { prompts++; value = strip(substr(t, RSTART + 1)) }
    } else {
      kind = "error"; bad = 1
    }
  }
  if (mode != "rewrite") next
  if (kind == "header") {
    if (indef && !done) put(lead(raw))
    flush(); print raw cr
    indef = (sect == "DEFAULT"); if (indef) seen = 1
    drop = 0
  } else if (kind == "cont") {
    if (!drop) { flush(); print raw cr }
  } else if (kind == "option" && sect == "DEFAULT" && key == "prompt") {
    flush()
    if (!done) { print lead(raw) "Prompt=" v cr; done = 1 }
    drop = 1
  } else if (kind == "blank" && indef && !done) {
    held = held raw cr "\n"
  } else {
    if (kind == "option") drop = 0
    flush(); print raw cr
  }
}
END {
  if (mode == "check") { sub(/[ \t\v\f\n]+$/, "", value); exit (odd || bad || prompts != 1 || tolower(value) != v) }
  if (mode == "probe") exit (odd || bad || prompts == 0)
  if (indef && !done) put("")
  flush()
  if (!seen) { print "[DEFAULT]" eol; put("") }
}'

if [ -e "$file" ]; then src=$file; else src=/dev/null; fi
awk -v mode=rewrite -v v="$value" "$CFG" < "$src" > "$tmp" || { rm -f -- "$tmp"; fail write; }
awk -v mode=check -v v="$value" "$CFG" < "$tmp" || { rm -f -- "$tmp"; fail parse; }
chown "$owner" "$tmp" || { rm -f -- "$tmp"; fail chown; }
chmod 0644 "$tmp" || { rm -f -- "$tmp"; fail chmod; }
sync "$tmp" || { rm -f -- "$tmp"; fail sync; }
mv -f -- "$tmp" "$file" || { rm -f -- "$tmp"; fail mv; }
sync "$dir" || true
echo "@@ok prompt=$value"

# The overrides Ubuntu reads after this file (sorted, the last Prompt= wins): named, never changed.
for cfg in "$dir"/release-upgrades.d/*.cfg; do
  [ -f "$cfg" ] || continue
  if awk -v mode=probe -v v= "$CFG" < "$cfg"; then
    echo "@@override $cfg"
  fi
done
exit 0
