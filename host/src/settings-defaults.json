  "explorer": {
    "view": "details",
    "showHidden": false,
    "showExtensions": true,
    "sortBy": "name",
    "sortDesc": false,
    "groupBy": "none",
    "navPane": true,
    "detailsPane": false,
    "previewPane": false,
    "checkboxes": false,
    "compact": false,
    "navWidth": 248,
    "columns": {},
    "hiddenColumns": [],
    "favorites": []
  },
  "privacy": {
    "recentFiles": true
  },
  "power": {
    "confirm": true
  },
  "search": {
    "webEngine": "https://duckduckgo.com/?q="
  },
  "update": {
    "notifyRestart": true,
    "metered": false,
    "winpointAutoCheck": true,
    "autoOpenPrevious": null,
    "ubuntuHoldPrevious": null
