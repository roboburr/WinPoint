{
  "version": 1,
  "language": "nl",
  "theme": {
    "mode": "dark",
    "accent": "#0067c0",
    "accentFromWallpaper": false,
    "transparency": true,
    "syncSystem": true,
    "accentOnTaskbar": false,
    "captionButtons": true,
    "gtkFamily": "system"
  },
  "wallpaper": {
    "type": "image",
    "path": "builtin:lotus-dark",
    "pathDark": "",
    "color": "#0b2a4a",
    "fit": "fill",
    "followTheme": true
  },
  "taskbar": {
    "alignment": "center",
    "search": "box",
    "taskView": true,
    "widgets": false,
    "autoHide": false,
    "allDisplays": true,
    "multiDisplayApps": "window",
    "showSeconds": false,
    "batteryPercent": false,
    "allDesktops": false,
    "pinned": [
      "win11shell-explorer.desktop",
      "firefox_firefox.desktop",
      "snap-store_snap-store.desktop",
      "win11shell-settings.desktop"
    ],
    "tray": {
      "hiddenMenu": true,
      "shown": [],
      "order": [],
      "known": {}
    }
  },
  "start": {
    "pinned": [],
    "showRecommended": true,
    "showRecentApps": true,
    "windowsKey": true,
    "layout": "default",
    "folders": [
      "settings",
      "explorer",
      "documents",
      "downloads"
    ]
  },
  "desktop": {
    "showIcons": true,
    "iconSize": "medium",
    "autoArrange": false,
    "alignToGrid": true,
    "sortBy": "name",
    "positions": {},
    "showThisPC": true,
    "showTrash": true,
    "showHome": false
  },
  "notifications": {
    "dnd": false,
    "sounds": true,
    "showToasts": true
  },
  "time": {
    "h24": true,
    "showSeconds": false,
    "showDate": true,
    "showWeekday": false,
    "weekNumbers": false,
    "firstDayOfWeek": -1
  },
  "taskView": {
    "allDesktops": false
  },
  "accessibility": {
    "textScale": 100,
    "reduceMotion": false,
    "highContrast": false
  },
  "nightLight": {
    "enabled": false,
    "temperature": 4500
